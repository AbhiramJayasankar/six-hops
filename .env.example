# --- required ---
APP_PASSWORD=change-me
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets.token_hex-32
ME_NAME=Your Name

# --- optional ---
# API_TOKEN=               # enables `Authorization: Bearer <token>` for curl/scripts
# COOKIE_SECURE=true       # set when served over HTTPS
# BASE_URL=https://6hops.example.com
# DATABASE_URL=sqlite:///data/6hops.db

# --- LLM (used from M7) ---
LLM_PROVIDER=gemini
GEMINI_MODE=vertex         # vertex | api_key
GEMINI_MODEL=gemini-2.5-flash
# Vertex mode: auth via ADC (`gcloud auth application-default login`) or a service account
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp.json
# API-key mode:
# GEMINI_API_KEY=
